{
  "name": "engineering-portfolio-quality-checks",
  "private": true,
  "version": "1.0.0",
  "description": "CI-only validation tooling for the static portfolio",
  "scripts": {
    "check:css": "node scripts/css-quality.js",
    "check:browser": "node scripts/browser-quality.js",
    "check:visual": "node scripts/visual-regression.js",
    "report:lighthouse": "node scripts/lighthouse-report.js",
    "check:models": "node scripts/workbench-models-test.js && node scripts/robotics-experiment-test.js",
    "check:workbench-browser": "node scripts/workbench-smoke.js",
    "report:phase4": "node scripts/lighthouse-phase4-report.js",
    "check:static": "node scripts/site-check.js && node scripts/navigation-quality.js && node scripts/sync-asset-versions.js --check && node scripts/external-links.js --inventory && node --test scripts/external-links.test.js && node scripts/css-quality.js && node scripts/workbench-models-test.js && node scripts/robotics-experiment-test.js",
    "check:structured": "node scripts/structured-data.js --check",
    "sync:structured": "node scripts/structured-data.js --write",
    "check:assets": "node scripts/sync-asset-versions.js --check",
    "check:navigation": "node scripts/navigation-quality.js",
    "check:external:inventory": "node scripts/external-links.js --inventory",
    "check:external": "node scripts/external-links.js --check",
    "test:external": "node --test scripts/external-links.test.js",
    "sync:assets": "node scripts/sync-asset-versions.js --write"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "css-tree": "3.1.0",
    "lighthouse": "12.8.2",
    "playwright": "1.56.1"
  }
}
